# cp .env.example .env, fill in the keys, and load it with: set -a && source .env && set +a

# GPT-6 Luna: golden step judge, validation judge, and the autorater
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# GPT-6 Sol: SWE-QA-Pro judge
LITELLM_BASE_URL=https://api.openai.com/v1
LITELLM_API_KEY=

# Claude Sonnet 5.5: SWE-QA judge (reads LITELLM_API_KEY as its key)
LITELLM_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Weights & Biases for the training logs (or set WANDB_MODE=offline)
WANDB_API_KEY=
